# Server settings
SERVER_NAME=intania
SERVER_ENV=development
SERVER_URL=http://localhost:8080/api/v1
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
# direct ignores forwarding headers; cloud_run requires K_SERVICE and a verified one-hop ingress.
SERVER_CLIENT_IP_MODE=direct

# Fallback daily reward used when a date has no configured override
DAILY_REWARD_DEFAULT_AMOUNT=300.00

# Fixed team coins a color earns for each match it wins by vote (more of its bettors picked the winner than the loser).
TEAM_COIN_PER_MATCH_WIN=1000.00

# Database: PGSQL
# The API runs on the host with Air; use "postgres" only when the API joins the Compose network.
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASS=1234
DB_NAME=intania888_db
DB_SSL_MODE=disable
DB_TIMEZONE=Asia/Bangkok

# JWT settings
JWT_ACCESS_TOKEN_SECRET=access-token-secret

# OAUTH (GOOGLE)
OAUTH_CLIENT_ID=your-client-id-here
OAUTH_CLIENT_SECRET=your-client-secret-here

# AUTH CONFIG FILE
AUTH_CONFIG_FILE=./config/auth.development.yaml

## Supply this through the process environment or Compose env_file. Use a random secret.
INTANIA_GAMES_CLIENT_SECRET=replace-with-at-least-32-random-characters

# Browser session timeouts, in seconds. Idle TTL renews on activity; absolute TTL is measured from login.
SESSION_IDLE_TTL_SECONDS=604800
SESSION_ABSOLUTE_TTL_SECONDS=2592000

# REDIS
CACHE_HOST=localhost
CACHE_PORT=6379
CACHE_PASS=1234

# Swagger
SWAGGER_ENABLED=true
SWAGGER_REQUIRE_AUTH=false
SWAGGER_USERNAME=replace-with-local-username
SWAGGER_PASSWORD=replace-with-local-password

# Browser origins (exact scheme, host, and port; no wildcard with credentials)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080

# Process-local token refill rates per minute and burst capacities; see docs/rate-limiting.md.
RATE_LIMIT_SHARED_PER_MINUTE=60000
RATE_LIMIT_SHARED_BURST=2000
RATE_LIMIT_BROWSER_PER_MINUTE=300
RATE_LIMIT_BROWSER_BURST=20
RATE_LIMIT_LOGIN_PER_MINUTE=1200
RATE_LIMIT_LOGIN_BURST=100
RATE_LIMIT_CALLBACK_PER_MINUTE=1200
RATE_LIMIT_CALLBACK_BURST=100
RATE_LIMIT_TOKEN_PER_MINUTE=2000
RATE_LIMIT_TOKEN_BURST=200
RATE_LIMIT_REVOKE_PER_MINUTE=2000
RATE_LIMIT_REVOKE_BURST=200
RATE_LIMIT_INVALID_CLIENT_PER_MINUTE=30
RATE_LIMIT_INVALID_CLIENT_BURST=5
RATE_LIMIT_INVALID_EXTERNAL_PER_MINUTE=120
RATE_LIMIT_INVALID_EXTERNAL_BURST=10
RATE_LIMIT_EXTERNAL_CLIENT_PER_MINUTE=10000
RATE_LIMIT_EXTERNAL_CLIENT_BURST=300
RATE_LIMIT_EXTERNAL_PROFILE_PER_MINUTE=60
RATE_LIMIT_EXTERNAL_PROFILE_BURST=5
RATE_LIMIT_EXTERNAL_TRANSACTION_PER_MINUTE=10
RATE_LIMIT_EXTERNAL_TRANSACTION_BURST=3
