# Server settings
SERVER_NAME=intania
SERVER_ENV=development
SERVER_URL=http://localhost:8080/api/v1
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Fallback daily reward used when a date has no configured override
DAILY_REWARD_DEFAULT_AMOUNT=300.00

# Database: PGSQL
# The API runs on the host with Air; use "postgres" only when the API joins the Compose network.
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASS=1234
DB_NAME=intania888_db
DB_SSL_MODE=disable
DB_TIMEZONE=Asia/Bangkok

# JWT settings
JWT_ACCESS_TOKEN_SECRET=access-token-secret

# OAUTH
OAUTH_CLIENT_ID=your-client-id-here
OAUTH_CLIENT_SECRET=your-client-secret-here
OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/callback
OAUTH_POST_LOGIN_REDIRECT_URL=http://localhost:3000
# OAuth login state lifetime, in seconds
OAUTH_STATE_EXPIRATION=600

# Browser session timeouts, in seconds. Idle TTL renews on activity; absolute TTL is measured from login.
SESSION_IDLE_TTL_SECONDS=604800
SESSION_ABSOLUTE_TTL_SECONDS=2592000

# REDIS
CACHE_HOST=localhost
CACHE_PORT=6379
CACHE_PASS=1234

# Swagger
SWAGGER_ENABLED=true
SWAGGER_REQUIRE_AUTH=false
SWAGGER_USERNAME=replace-with-local-username
SWAGGER_PASSWORD=replace-with-local-password

# Browser origins (exact scheme, host, and port; no wildcard with credentials)
CORS_ALLOW_ORIGINS=http://localhost:3000
